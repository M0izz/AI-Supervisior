# AI Supervisor Control Room - Frontend Environment Configuration

# Render Backend API URL (leave empty for local dev with default Vite proxy)
# In production on Vercel, set this to your deployed Render service URL:
# VITE_API_URL=https://ai-supervisor-api.onrender.com

# Optional explicit WebSocket URL (automatically derived from VITE_API_URL if omitted)
# VITE_WS_URL=wss://ai-supervisor-api.onrender.com/ws/events
