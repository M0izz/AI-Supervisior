# AI Work Supervisor Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Reasoning Provider: Nebius / Nemotron
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1
SUPERVISOR_MODEL=nvidia/nemotron-4-340b-instruct
WORKER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Fallback / Local mock provider
USE_MOCK_REASONING=true

# Database (SQLite default for MVP, switchable to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./supervisor.db

# Workspace sandbox root for agent execution
SANDBOX_WORKSPACE_DIR=./demo/sample-project
