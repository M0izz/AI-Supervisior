# AI Work Supervisor Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Reasoning Provider: Nebius AI Studio
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Multi-Model Inference & Routing: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# Sovereign AI Infrastructure & Persistent Memory: Backboard.io (Espri.ai)
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Open-Source Hub & Serverless Inference: Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co

# Multimodal & Deep Diagnostic Reasoning: Google Gemini API
GEMINI_API_KEY=

# Cloud Infrastructure & Supervisory Planning: DigitalOcean + Google Gemma 4
DIGITALOCEAN_TOKEN=
DO_INFERENCE_KEY=
DO_INFERENCE_ENDPOINT=https://inference.digitalocean.com/v1
GEMMA_MODEL=gemma-4-31B-it

# Supervisor Engine Runtime Parameters
SUPERVISOR_MAX_ITERATIONS=25
SUPERVISOR_FAILURE_THRESHOLD=3
SUPERVISOR_MAX_RECENT_EVENTS=20
SUPERVISOR_MODEL_TIMEOUT_SECONDS=20

# Fallback / Local mock provider
USE_MOCK_REASONING=true

# Database (SQLite local-first persistence)
DATABASE_URL=sqlite+aiosqlite:///./supervisor.db

# FalkorDB Graph Memory & Coordination Layer
# For Local Docker Container:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=ai_supervisor_memory
FALKORDB_TIMEOUT=10
FALKORDB_SSL=false

# For Hosted FalkorDB Cloud:
# Set FALKORDB_HOST to your cloud instance host (e.g. your-db.falkordb.cloud)
# Set FALKORDB_PORT to your cloud instance port (e.g. 14322)
# Set FALKORDB_USERNAME (e.g. default or your user)
# Set FALKORDB_PASSWORD to your cloud password
# Set FALKORDB_SSL=true (required by FalkorDB Cloud TLS)
# Alternatively, provide a full connection URI (e.g. falkors://username:password@host:port):
# FALKORDB_URL=


# Workspace sandbox root for agent execution
SANDBOX_WORKSPACE_DIR=./demo/sample-project

# Phase 5 Execution Layer: Local vs Docker Container Isolation
EXECUTION_BACKEND=local
EXECUTION_ALLOW_FALLBACK=false
DOCKER_IMAGE=ai-work-supervisor-worker:latest
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=128
DOCKER_NETWORK_DISABLED=true
DOCKER_TIMEOUT_SECONDS=120

# Phase 6: Jenkins CI Integration
JENKINS_ENABLED=false
JENKINS_URL=http://localhost:8080
JENKINS_JOB_NAME=ai-work-supervisor
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_TIMEOUT_SECONDS=30
# Phase 9: Control Room Frontend
VITE_API_URL=http://localhost:8000

